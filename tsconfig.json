{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "outDir": "dist",
    "sourceMap": true,
    "moduleResolution": "nodenext",
    "module": "NodeNext"
  },
  "include": ["src/**/*.ts"]
}

